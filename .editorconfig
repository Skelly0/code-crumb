root = true

# Markdown is trimmed too: CI's whitespace gate fails a push on trailing
# whitespace in js/mjs/md/json/yml, so a two-space hard break cannot land
# anyway (use a blank line or <br>).
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.cmd]
end_of_line = crlf
