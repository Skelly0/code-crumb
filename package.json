{
  "name": "code-crumb",
  "version": "1.2.0",
  "description": "A terminal tamagotchi that shows what AI coding assistants are doing",
  "main": "renderer.js",
  "type": "commonjs",
  "bin": {
    "code-crumb": "./launch.js"
  },
  "scripts": {
    "start": "node renderer.js",
    "minimal": "node renderer.js --minimal",
    "launch": "node launch.js",
    "launch:codex": "node launch.js --editor codex",
    "launch:opencode": "node launch.js --editor opencode",
    "launch:openclaw": "node launch.js --editor openclaw",
    "demo": "node demo/single.js",
    "demo:orbital": "node demo/orbital.js",
    "setup": "node setup.js",
    "setup:claude": "node setup.js claude",
    "setup:codex": "node setup.js codex",
    "setup:opencode": "node setup.js opencode",
    "setup:openclaw": "node setup.js openclaw",
    "setup:uninstall": "node setup.js uninstall",
    "tmux": "node renderer.js --tmux",
    "test": "node tests/run.js"
  },
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "opencode",
    "openclaw",
    "terminal",
    "ascii-art",
    "tamagotchi",
    "hooks",
    "plugin",
    "ai-assistant",
    "cli"
  ],
  "license": "MIT",
  "author": {
    "name": "Skelly0",
    "url": "https://github.com/Skelly0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Skelly0/code-crumb.git"
  },
  "homepage": "https://github.com/Skelly0/code-crumb#readme",
  "bugs": {
    "url": "https://github.com/Skelly0/code-crumb/issues"
  },
  "files": [
    "renderer.js",
    "launch.js",
    "setup.js",
    "update-state.js",
    "lib/",
    "adapters/",
    "hooks/",
    "code-crumb.sh",
    "code-crumb.cmd",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
